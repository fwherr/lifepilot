# ---------------------------------------------------------------------------
# LifePilot — architecture slice 1
# Copy to `.env` (root) before running. Every service reads from here.
# All values below are safe development defaults.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL, matches docker-compose.yml) ---
DATABASE_URL="postgresql://lifepilot:lifepilot@localhost:5432/lifepilot?schema=public"

# --- Redis (BullMQ queue backend, matches docker-compose.yml) ---
REDIS_URL="redis://localhost:6379"

# --- API (apps/api) ---
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# Change this in any shared/production environment!
JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
LOG_LEVEL=info

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Email delivery (apps/worker) ---
# "console" prints emails to the worker log instead of sending (dev default).
# "smtp" sends through the SMTP server configured below.
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LifePilot <no-reply@lifepilot.local>"

# --- Outgoing webhook channel ---
# HMAC-SHA256 signing secret used when the worker POSTs reminder payloads.
# The signature is sent as:  x-lifepilot-signature: sha256=<hex hmac of raw body>
WEBHOOK_SIGNING_SECRET=dev-webhook-secret

# --- Attachments (MinIO / S3-compatible object storage, matches docker-compose.yml) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=lifepilot-attachments
S3_FORCE_PATH_STYLE=true

# --- Razorpay (test mode) ---
# Leave KEY_ID/KEY_SECRET empty to use the built-in simulated order flow
# (orders are generated locally and clearly marked "simulated" — no network).
# Fill in real *test-mode* keys (rzp_test_...) to create actual Razorpay orders.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret used to verify incoming Razorpay webhook signatures (X-Razorpay-Signature).
RAZORPAY_WEBHOOK_SECRET=dev-razorpay-webhook-secret
