{
  "name": "@lifepilot/worker",
  "version": "0.1.0",
  "private": true,
  "description": "LifePilot BullMQ worker: delivers reminders through pluggable channel adapters (email, whatsapp, ai-agent, webhook, razorpay)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lifepilot/core": "workspace:*",
    "@lifepilot/db": "workspace:*",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
